{
  "name": "hurteemj",
  "version": "1.0.0",
  "description": "WCAG 2.2 (ISO/IEC 40500) аудит, аюулгүй засвар, хэрэглэгчийн тохиргооны нэгдсэн plugin. Ямар ч системд нэг мөр кодоор холбогдоно.",
  "type": "module",
  "main": "dist/hurteemj.esm.js",
  "module": "dist/hurteemj.esm.js",
  "browser": "dist/hurteemj.min.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/hurteemj.esm.js"
    },
    "./react": "./integrations/react/index.js",
    "./vue": "./integrations/vue/index.js",
    "./element": "./integrations/web-component/index.js",
    "./criteria": "./src/wcag/criteria.js",
    "./dist/*": "./dist/*"
  },
  "bin": {
    "hurteemj-audit": "cli/audit.js"
  },
  "files": [
    "dist",
    "src",
    "integrations",
    "cli",
    "types"
  ],
  "sideEffects": [
    "./dist/hurteemj.min.js",
    "./dist/hurteemj.js",
    "./integrations/web-component/index.js"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node build.js",
    "test": "npm run build && node --test test/*.test.js",
    "docs": "node scripts/gen-docs.js",
    "prepublishOnly": "npm run build && npm run docs",
    "audit:url": "node cli/audit.js"
  },
  "peerDependencies": {
    "playwright": ">=1.40",
    "react": ">=17",
    "vue": ">=3"
  },
  "keywords": [
    "wcag",
    "wcag22",
    "accessibility",
    "a11y",
    "хүртээмж",
    "en301549",
    "iso40500"
  ],
  "license": "MIT",
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "axe-core": "^4.11.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  }
}
